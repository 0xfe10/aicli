{
  "swagger": "2.0",
  "info": {"title": "Sample", "version": "1.0"},
  "host": "localhost:9000",
  "basePath": "/",
  "schemes": ["https"],
  "paths": {
    "/api/file": {
      "get": {
        "produces": ["application/octet-stream"],
        "parameters": [
          {"name": "path", "in": "query", "required": true, "type": "string"},
          {"name": "vault", "in": "query", "required": true, "type": "string"}
        ],
        "responses": {
          "200": {
            "description": "file",
            "schema": {"type": "file"}
          }
        }
      },
      "post": {
        "consumes": ["multipart/form-data"],
        "parameters": [
          {"name": "file", "in": "formData", "required": true, "type": "file"},
          {"name": "path", "in": "formData", "required": true, "type": "string"},
          {"name": "vault", "in": "formData", "required": true, "type": "string"}
        ],
        "responses": {"200": {"description": "ok"}}
      }
    }
  }
}
