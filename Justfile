set shell := ["bash", "-eo", "pipefail", "-c"]

version := env_var_or_default("VERSION", "0.1.0")
commit := env_var_or_default("COMMIT", `git rev-parse --short=12 HEAD 2>/dev/null || echo unknown`)
out_dir := env_var_or_default("OUT_DIR", "dist")
mcp2cli_version := "0.1.10"

default:
    @just --list

verify:
    #!/usr/bin/env bash
    set -euo pipefail
    umask 0022
    go mod verify
    go test ./...
    go test -race ./...
    go vet ./...

# Download the current official PingCode API description and prove that the
# loader can convert the complete corpus.
pingcode-spec-check:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "{{ out_dir }}"
    spec_file="$(mktemp "$(cd "{{ out_dir }}" && pwd)/pingcode-api-data.XXXXXX.json")"
    trap 'rm "$spec_file"' EXIT
    curl --fail --silent --show-error --location \
      https://open.pingcode.com/api_data.json \
      --output "$spec_file"
    PINGCODE_API_DATA_FILE="$spec_file" \
      go test -run TestOfficialAPIDocFile -v ./internal/pingcodert

# Download the pinned default FNS Swagger description and prove conversion,
# filtering, and Restish command generation against it.
fns-spec-check:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "{{ out_dir }}"
    spec_file="$(mktemp "$(cd "{{ out_dir }}" && pwd)/fns-swagger.XXXXXX.yaml")"
    trap 'rm "$spec_file"' EXIT
    curl --fail --silent --show-error --location \
      https://raw.githubusercontent.com/haierkeys/fast-note-sync-service/b6b4566352f39e0404530ed1b58248a815a6d763/docs/swagger.yaml \
      --output "$spec_file"
    actual="$(sha256sum "$spec_file" | awk '{print $1}')"
    expect="ae6a880bb9accf472f45d41a922db67617755ce6b7352aef971e7f969ad0d113"
    if [[ "$actual" != "$expect" ]]; then
      echo "pinned FNS swagger SHA256 mismatch: got $actual want $expect" >&2
      exit 1
    fi
    FNS_SPEC_CHECK_FILE="$spec_file" \
      go test -run TestPinnedSpecFile -v ./internal/fnsrt

# Download the pinned complete Ozon Seller OpenAPI snapshot and prove that all
# operations can be repaired and converted into a Restish command tree.
ozon-spec-check:
    #!/usr/bin/env bash
    set -euo pipefail
    spec_file="$(mktemp /tmp/ozon-seller-openapi.XXXXXX.json)"
    trap 'rm "$spec_file"' EXIT
    curl --fail --silent --show-error --location \
      https://raw.githubusercontent.com/PCDCK/ozon-mcp/7e1bea2dd7510064311f1d357d014bb012a18847/src/ozon_mcp/data/seller_swagger.json \
      --output "$spec_file"
    actual="$(sha256sum "$spec_file" | awk '{print $1}')"
    expect="c54962e9481ac776e14c0fe4f987e0ff74fde68a793e6b640f70db6cdaabdba5"
    if [[ "$actual" != "$expect" ]]; then
      echo "pinned Ozon OpenAPI SHA256 mismatch: got $actual want $expect" >&2
      exit 1
    fi
    OZON_SPEC_CHECK_FILE="$spec_file" \
      go test -count=1 -run TestFullSellerSpecCorpus -v ./internal/ozonrt

# Refresh and verify third-party compliance evidence for release binaries.
compliance-check:
    #!/usr/bin/env bash
    set -euo pipefail
    umask 0022
    {
      echo "# Linked module closure for release binaries"
      echo "# Generated by: just compliance-check"
      echo "# Scope: union of go list -deps for ./cmd/aicli ./cmd/pingcode ./cmd/fns ./cmd/ozon ./cmd/lanhu"
      echo
      for pkg in ./cmd/aicli ./cmd/pingcode ./cmd/fns ./cmd/ozon ./cmd/lanhu; do
        echo "## $pkg"
        go list -deps -json "$pkg" | jq -r 'select((.Standard|not) and .Module != null and (.Module.Main|not)) | [.Module.Path, .Module.Version] | @tsv' | sort -u
        echo
      done
      echo "## union"
      for pkg in ./cmd/aicli ./cmd/pingcode ./cmd/fns ./cmd/ozon ./cmd/lanhu; do
        go list -deps -json "$pkg" | jq -r 'select((.Standard|not) and .Module != null and (.Module.Main|not)) | [.Module.Path, .Module.Version] | @tsv'
      done | sort -u
    } > openwiki/compliance/modules-linked.txt
    go mod verify | tee openwiki/compliance/go-mod-verify.txt
    go tool govulncheck -json ./... > openwiki/compliance/govulncheck.json
    # Human-readable evidence copy; gate decides pass/fail from JSON.
    go tool govulncheck ./... > openwiki/compliance/govulncheck.txt 2>&1 || true
    go run ./internal/compliance/gate \
      -findings openwiki/compliance/govulncheck.json \
      -allowlist openwiki/compliance/govulncheck-allowlist.md

test:
    go test ./...

