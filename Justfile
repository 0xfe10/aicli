    go test ./internal/swagger2rt ./internal/fnsrt ./cmd/fns

test-ozon:
    go test ./internal/ozonrt ./cmd/ozon

test-lanhu:
    go test ./internal/lanhurt ./cmd/lanhu

test-devopsh:
    go test ./internal/devopshrt ./cmd/devopsh

